@model List<RaceEvent>
<h1>Manage events</h1><a class="btn btn-success mb-3" asp-action="Create">Create event</a><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Management</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.City</td><td><a asp-action="Edit" asp-route-id="@e.EventId">Edit</a> · <a asp-action="Categories" asp-route-id="@e.EventId">Categories</a> · <a asp-action="Enrolments" asp-route-id="@e.EventId">Entries</a> · <a asp-action="Results" asp-route-id="@e.EventId">Results</a><form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"><button class="btn btn-link text-danger">Delete</button></form><form asp-action="Banner" asp-route-id="@e.EventId" method="post" enctype="multipart/form-data"><input type="file" name="file" accept="image/*"/><button class="btn btn-sm btn-outline-secondary">Upload banner</button></form></td></tr>}</tbody></table>