@model List<RaceResult>
<h1>Results · @ViewBag.Event?.EventName</h1><form asp-action="PublishResult" asp-route-id="@ViewBag.Event?.EventId" method="post"><select name="enrolmentId" class="form-select mb-2">@foreach(Enrolment e in ViewBag.Entries){<option value="@e.EnrolmentId">Entry @e.EnrolmentId · participant @e.ParticipantId</option>}</select><input name="finishPosition" type="number" min="1" class="form-control mb-2" placeholder="Position"/><input name="finishTimeSeconds" type="number" min="1" class="form-control mb-2" placeholder="Finish time seconds"/><select name="resultStatus" class="form-select mb-2"><option>Finished</option><option>DNF</option><option>DNS</option><option>Disqualified</option></select><button class="btn btn-success">Publish result</button></form><table class="table mt-4"><tr><th>Participant</th><th>Position</th><th>Time</th><th>Status</th></tr>@foreach(var r in Model){<tr><td>@r.ParticipantName</td><td>@r.FinishPosition</td><td>@(r.FinishTimeSeconds.HasValue?TimeSpan.FromSeconds(r.FinishTimeSeconds.Value).ToString(@"hh\:mm\:ss"):"—")</td><td>@r.ResultStatus</td></tr>}</table>