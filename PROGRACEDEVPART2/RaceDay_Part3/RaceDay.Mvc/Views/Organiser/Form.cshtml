@model RaceDay.Mvc.Models.EventForm
<h1>Event details</h1><form method="post"><input asp-for="EventId" type="hidden"/><label asp-for="EventName"></label><input asp-for="EventName" class="form-control mb-2"/><label asp-for="Description"></label><textarea asp-for="Description" class="form-control mb-2"></textarea><label asp-for="EventDate"></label><input asp-for="EventDate" type="date" class="form-control mb-2"/><label asp-for="Venue"></label><input asp-for="Venue" class="form-control mb-2"/><label asp-for="City"></label><input asp-for="City" class="form-control mb-2"/><label asp-for="Province"></label><input asp-for="Province" class="form-control mb-2"/><label asp-for="EventType"></label><select asp-for="EventType" class="form-select mb-2"><option>Running</option><option>Walking</option><option>Cycling</option></select><label asp-for="Status"></label><select asp-for="Status" class="form-select mb-3"><option>Upcoming</option><option>Draft</option><option>Completed</option><option>Cancelled</option></select><button class="btn btn-success">Save</button></form>