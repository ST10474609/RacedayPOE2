@model List<Category>
<h1>Categories · @ViewBag.Event?.EventName</h1><ul>@foreach(var c in Model){<li>@c.CategoryName — @c.DistanceKm km — R @c.EntryFee</li>}</ul><form asp-action="AddCategory" asp-route-id="@ViewBag.Id" method="post"><input name="categoryName" class="form-control mb-2" placeholder="Category name" required/><input name="distanceKm" type="number" step=".1" class="form-control mb-2" placeholder="Distance km" required/><input name="entryFee" type="number" step=".01" class="form-control mb-2" placeholder="Entry fee" required/><input name="maximumParticipants" type="number" class="form-control mb-2" placeholder="Max participants"/><button class="btn btn-success">Add category</button></form>