@model List<Category>
<h1>Categories · @ViewBag.Event?.EventName</h1><div class="row g-3 mb-4">@foreach(var c in Model){<div class="col-lg-6"><div class="card p-3"><form asp-action="UpdateCategory" method="post"><input type="hidden" name="id" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@ViewBag.Id"/><label class="form-label">Category name</label><input name="categoryName" value="@c.CategoryName" class="form-control mb-2" required/><label class="form-label">Distance (km)</label><input name="distanceKm" type="number" step=".1" min=".1" value="@c.DistanceKm" class="form-control mb-2" required/><label class="form-label">Entry fee (R)</label><input name="entryFee" type="number" step=".01" min="0" value="@c.EntryFee" class="form-control mb-2" required/><label class="form-label">Maximum participants</label><input name="maximumParticipants" type="number" min="1" value="@c.MaximumParticipants" class="form-control mb-2"/><button class="btn btn-outline-dark">Save changes</button></form><form asp-action="DeleteCategory" method="post" class="mt-2"><input type="hidden" name="id" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@ViewBag.Id"/><button class="btn btn-sm btn-outline-danger">Delete category</button></form></div></div>}</div><form asp-action="AddCategory" asp-route-id="@ViewBag.Id" method="post"><input name="categoryName" class="form-control mb-2" placeholder="Category name" required/><input name="distanceKm" type="number" step=".1" class="form-control mb-2" placeholder="Distance km" required/><input name="entryFee" type="number" step=".01" class="form-control mb-2" placeholder="Entry fee" required/><input name="maximumParticipants" type="number" class="form-control mb-2" placeholder="Max participants"/><button class="btn btn-success">Add category</button></form>