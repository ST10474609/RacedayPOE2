@model List<RaceEvent>
<section class="hero p-5 mb-4"><small>THE SOUTH AFRICAN RACE COMMUNITY</small><h1 class="display-3 fw-bold">Your next finish line<br/><span>starts right here.</span></h1><p class="lead">Discover running, walking and cycling events. Find your distance and get race-ready.</p></section><div class="card p-3 mb-4"><form method="get" class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Search events</label><input name="q" value="@ViewBag.Query" class="form-control" placeholder="Event name or description"/></div><div class="col-md-3"><label class="form-label">Event type</label><select name="type" class="form-select"><option value="">All types</option><option selected="@(ViewBag.Type=="Running")">Running</option><option selected="@(ViewBag.Type=="Walking")">Walking</option><option selected="@(ViewBag.Type=="Cycling")">Cycling</option></select></div><div class="col-md-3"><label class="form-label">City</label><input name="city" value="@ViewBag.City" class="form-control" placeholder="e.g. Mbombela"/></div><div class="col-md-1"><button class="btn btn-success w-100">Go</button></div></form></div><h2 class="fw-bold">Upcoming events</h2><div class="row g-3">@foreach(var e in Model.Where(x=>x.Status!="Cancelled").OrderBy(x=>x.EventDate)){<div class="col-md-4"><div class="card h-100 p-3"><span class="badge bg-success align-self-start">@e.EventType</span>@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img src="@e.BannerImageUrl" class="img-fluid rounded mb-2" alt="Event banner"/>}<h3 class="h4 mt-3">@e.EventName</h3><p>@e.EventDate.ToString("dd MMM yyyy") · @e.City</p><p>@e.Venue</p><a class="btn btn-dark mt-auto" asp-action="Details" asp-route-id="@e.EventId">View details</a></div></div>}</div>