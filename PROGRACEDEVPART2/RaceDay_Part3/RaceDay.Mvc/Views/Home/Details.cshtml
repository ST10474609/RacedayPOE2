@model EventDetails
<h1 class="fw-bold">@Model.Event.EventName</h1><p class="lead">@Model.Event.Description</p><p>📅 @Model.Event.EventDate.ToString("dd MMMM yyyy") · 📍 @Model.Event.Venue, @Model.Event.City · @Model.Event.EventType</p><h2>Available categories</h2><div class="row g-3">@foreach(var c in Model.Categories){<div class="col-md-5"><div class="card p-3"><h3 class="h5">@c.CategoryName</h3><p>@c.DistanceKm km · R @c.EntryFee</p>@if(Context.Session.GetString("role")=="Participant"){<form asp-action="Enter" asp-route-id="@Model.Event.EventId" method="post"><input type="hidden" name="categoryId" value="@c.CategoryId"/><input name="emergencyContactName" class="form-control mb-2" placeholder="Emergency contact"/><input name="emergencyContactPhone" class="form-control mb-2" placeholder="Emergency phone"/><button class="btn btn-success">Enter event</button></form>}else{<a asp-controller="Account" asp-action="Login">Sign in to enter</a>}</div></div>}</div>