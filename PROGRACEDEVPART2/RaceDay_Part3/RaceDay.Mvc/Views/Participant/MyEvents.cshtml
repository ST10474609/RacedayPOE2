@model List<Enrolment>
<h1>My events</h1>@foreach(var e in Model){<div class="card p-3 mb-2"><h3>@e.EventName</h3><p>@e.CategoryName · @e.EnrolmentDate.ToString("dd MMM yyyy")</p><span class="badge bg-success">@e.EnrolmentStatus</span><form asp-action="Cancel" method="post" class="mt-2"><input type="hidden" name="id" value="@e.EnrolmentId"/><button class="btn btn-sm btn-outline-danger">Cancel entry</button></form></div>}