@model RaceDay.Mvc.Services.User
<h1>My profile</h1><form asp-action="UpdateProfile" method="post"><input name="firstName" value="@Model.FirstName" class="form-control mb-2"/><input name="lastName" value="@Model.LastName" class="form-control mb-2"/><input name="email" value="@Model.Email" class="form-control mb-2"/><input name="phoneNumber" value="@Model.PhoneNumber" class="form-control mb-2"/><button class="btn btn-success">Update profile</button></form><hr/><h2>Profile picture</h2><form asp-action="Picture" method="post" enctype="multipart/form-data"><input type="file" name="file" accept="image/*" class="form-control mb-2"/><button class="btn btn-outline-dark">Upload picture</button></form>