@model RaceDay.Mvc.Models.RegisterForm
<h1>Create your RaceDay account</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control mb-2"/></div><div class="col"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control mb-2"/></div></div><label asp-for="Email"></label><input asp-for="Email" class="form-control mb-2"/><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" class="form-control mb-2"/><label asp-for="Password"></label><input asp-for="Password" type="password" class="form-control mb-2"/><label asp-for="Role"></label><select asp-for="Role" class="form-select mb-3"><option>Participant</option><option>Organiser</option></select><button class="btn btn-success">Register</button></form>