<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RACEDAY</a><div class="navbar-nav ms-auto flex-row gap-3"><a class="nav-link" asp-controller="Home" asp-action="Index">Discover</a>@if(Context.Session.GetString("role")=="Organiser"){<a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage events</a>}@if(Context.Session.GetString("role")=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a><a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>}@if(Context.Session.GetString("role")==null){<a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>}else{<form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Sign out</button></form>}</div></div></nav><main class="container py-4">@if(TempData["Notice"]!=null){<div class="alert alert-info">@TempData["Notice"]</div>}@RenderBody()</main><footer class="text-center p-4 mt-5 bg-dark text-light">RaceDay · Move together. Finish stronger. · South Africa</footer></body></html>