@{ViewData["Title"]="Sign in";}<div class="row justify-content-center"><div class="col-md-6 col-lg-5"><div class="card"><div class="card-body p-4"><div class="eyebrow">Welcome back</div><h1 class="h3 fw-bold mb-4">Sign in to RaceDay</h1>@if(ViewBag.Error is string error){<div class="alert alert-danger">@error</div>}<form method="post"><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required/></div><div class="mb-3"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required/></div><button class="btn btn-warning w-100">Sign in</button></form><p class="small mt-3">New to RaceDay? <a asp-action="Register">Create an account</a></p></div></div></div></div>