@model IEnumerable<EventResponse>
@{ViewData["Title"]="Organiser dashboard";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><div class="eyebrow">Organiser workspace</div><h1 class="h2 fw-bold">Dashboard</h1></div><a class="btn btn-warning" asp-action="CreateEvent">Create event</a></div><div class="row g-3 mb-4"><div class="col-sm-6 col-lg-4"><div class="card"><div class="card-body"><div class="text-secondary small">Events managed</div><div class="stat">@Model.Count()</div></div></div></div><div class="col-sm-6 col-lg-4"><div class="card"><div class="card-body"><div class="text-secondary small">Upcoming events</div><div class="stat">@ViewBag.Upcoming</div></div></div></div></div>
<div class="card"><div class="card-body"><h2 class="h5">Your events</h2><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.City</td><td><span class="badge text-bg-light">@e.Status</span></td></tr>}</tbody></table></div></div></div>