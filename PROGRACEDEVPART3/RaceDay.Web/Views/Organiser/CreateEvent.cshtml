@model EventRequest
@{ViewData["Title"]="Create event";}
<div class="row justify-content-center"><div class="col-lg-8"><div class="card"><div class="card-body p-4"><h1 class="h3 fw-bold mb-4">Create an event</h1>@if(ViewBag.Error is string error){<div class="alert alert-danger">@error</div>}<form asp-action="CreateEvent" method="post"><div class="row g-3"><div class="col-12"><label asp-for="EventName" class="form-label">Event name</label><input asp-for="EventName" class="form-control" required/></div><div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="EventDate" class="form-label">Date</label><input asp-for="EventDate" type="date" class="form-control" required/></div><div class="col-md-6"><label asp-for="EventType" class="form-label">Event type</label><select asp-for="EventType" class="form-select"><option>Running</option><option>Walking</option><option>Cycling</option></select></div><div class="col-md-6"><label asp-for="Venue" class="form-label">Venue</label><input asp-for="Venue" class="form-control" required/></div><div class="col-md-6"><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control" required/></div><div class="col-md-6"><label asp-for="Province" class="form-label">Province</label><input asp-for="Province" class="form-control" required/></div><input type="hidden" asp-for="Status" value="Upcoming"/><div class="col-12"><button class="btn btn-warning">Save event</button></div></div></form></div></div></div></div>