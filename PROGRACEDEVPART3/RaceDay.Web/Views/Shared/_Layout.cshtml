<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet" asp-append-version="true"/></head>
<body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Events" asp-action="Index">RACEDAY<span class="text-warning">.</span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav me-auto"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
@if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My entries</a><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a>}
@if(Context.Session.GetString("Role")=="Organiser"){<a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">Create event</a>}</div><div class="navbar-nav align-items-lg-center">@if(Context.Session.GetString("Role") is not null){<span class="navbar-text me-3">@Context.Session.GetString("DisplayName")</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form>}else{<a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-warning btn-sm" asp-controller="Account" asp-action="Register">Create account</a>}</div></div></div></nav>
<main class="container py-4">@if(TempData["Message"] is string m){<div class="alert alert-success">@m</div>}@if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>}@RenderBody()</main><footer class="container border-top py-4 text-secondary small">RaceDay · Find your next finish line.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",false)</body></html>