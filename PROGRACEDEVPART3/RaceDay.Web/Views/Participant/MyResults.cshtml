@model IEnumerable<ResultResponse>
@{ViewData["Title"]="My results";}
<h1 class="h2 fw-bold mb-4">My results</h1><div class="card"><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Position</th><th>Finish time</th><th>Status</th><th>Recorded</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.EventName</td><td>@(r.FinishPosition?.ToString()??"—")</td><td>@(r.FinishTimeSeconds.HasValue?TimeSpan.FromSeconds(r.FinishTimeSeconds.Value).ToString(@"hh\:mm\:ss"):"—")</td><td>@r.ResultStatus</td><td>@r.RecordedAt.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="text-secondary mb-0">No results have been published for your entries.</p>}</div></div>