@model EventDetailsResponse
@{ViewData["Title"]=Model.Event.EventName;}
<a asp-action="Index" class="text-decoration-none text-secondary small">← All events</a><section class="hero my-3"><div class="eyebrow text-white-50">@Model.Event.EventType · @Model.Event.EventDate.ToString("dddd, dd MMMM yyyy")</div><h1 class="display-6 fw-bold mt-2">@Model.Event.EventName</h1><p class="text-white-50 mb-0">@Model.Event.Venue · @Model.Event.City, @Model.Event.Province</p></section>
@if(!string.IsNullOrWhiteSpace(Model.Event.Description)){<p class="lead">@Model.Event.Description</p>}<h2 class="h4 mt-4">Available categories</h2><div class="row g-3">
@foreach(var c in Model.Categories){<div class="col-md-6"><div class="card"><div class="card-body"><h3 class="h5">@c.CategoryName</h3><p class="text-secondary">@c.DistanceKm km · Entry R @c.EntryFee.ToString("0.00")</p>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@Model.Event.EventId"/><div class="mb-2"><input class="form-control" name="emergencyContactName" placeholder="Emergency contact name"/></div><div class="mb-2"><input class="form-control" name="emergencyContactPhone" placeholder="Emergency contact phone"/></div><button class="btn btn-warning w-100">Enter this category</button></form>}else if(Context.Session.GetString("Role") is null){<a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark">Sign in to enter</a>}</div></div></div>}
</div>