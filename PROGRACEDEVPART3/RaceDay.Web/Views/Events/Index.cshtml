@model IEnumerable<EventResponse>
@{ViewData["Title"]="Events";}
<section class="hero mb-4"><div class="eyebrow text-white-50">South Africa · Running · Walking · Cycling</div><h1 class="display-5 fw-bold mt-2">Find your next<br/>finish line.</h1><p class="text-white-50 mb-0">Discover events, choose your distance and make your next start count.</p></section>
<div class="d-flex justify-content-between align-items-end mb-3"><h2 class="h3 fw-bold">Upcoming events</h2><span class="text-secondary small">@Model.Count() events</span></div><div class="row g-3">
@foreach(var e in Model.Where(x=>x.Status!="Cancelled").OrderBy(x=>x.EventDate)){<div class="col-md-6 col-xl-4"><article class="card h-100"><div class="card-body d-flex flex-column"><div class="d-flex justify-content-between mb-3"><span class="badge text-bg-dark">@e.EventType</span><span class="small text-secondary">@e.EventDate.ToString("dd MMM yyyy")</span></div><h3 class="h5 fw-bold">@e.EventName</h3><p class="text-secondary small">@e.Venue · @e.City, @e.Province</p><p class="text-secondary flex-grow-1">@(string.IsNullOrWhiteSpace(e.Description)?"A RaceDay event.":e.Description)</p><a class="btn btn-outline-dark" asp-action="Details" asp-route-id="@e.EventId">View event</a></div></article></div>}
</div>